# Définissez la version minimale d'iOS pour votre application
platform :ios, '13.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# -------- localise le SDK Flutter ----------
def flutter_root
  generated_xcode_build_settings = File.expand_path(
    File.join('..', 'Flutter', 'Generated.xcconfig'),
    __FILE__
  )
  unless File.exist?(generated_xcode_build_settings)
    raise "#{generated_xcode_build_settings} must exist. Run 'flutter pub get' first."
  end
  File.foreach(generated_xcode_build_settings) do |line|
    if line =~ /FLUTTER_ROOT\=(.*)/
      return Regexp.last_match(1).strip
    end
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings}"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # Firebase + Google SDKs ➜ lier en statique pour éviter des surprises
  use_frameworks! :linkage => :static
  use_modular_headers!

  # Installe les Pods Flutter
  flutter_install_all_ios_pods(File.dirname(File.realpath(__FILE__)))
end

post_install do |installer|
  # Force TOUS les Pods à iOS 13.0 et Swift 5
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['SWIFT_VERSION'] = '5.0'
    end
  end

  # Hook Flutter (si dispo) pour appliquer ses réglages additionnels
  flutter_post_install(installer) if defined?(flutter_post_install)
end
